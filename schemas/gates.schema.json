{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyage-skill.local/schemas/gates.schema.json",
  "title": "VoyageSkill gates",
  "type": "object",
  "required": ["schema_version", "gates"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mandatory", "allow_skips", "required_loop"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "allow_skips": {"type": "boolean"},
          "required_loop": {"enum": ["quality"]},
          "risk_modes": {
            "type": "array",
            "items": {"enum": ["light", "standard", "strict"]},
            "uniqueItems": true
          },
          "risk_domains": {
            "type": "array",
            "items": {
              "enum": ["credentials", "gate-relaxation", "irreversible", "material-cost", "permissions", "persistent-data", "production", "public-external-write", "security"]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
