{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyage-skill.local/schemas/truth-registry.schema.json",
  "title": "VoyageSkill truth registry",
  "type": "object",
  "required": ["schema_version", "project", "sources"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "domain", "path", "version", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "active", "superseded", "retired"]},
          "authority": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "non_authoritative": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
